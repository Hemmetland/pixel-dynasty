{
  "name": "pixel-dynasty-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Dynasty – skrivbordsversion för testare (Electron-skal runt dist/index.html)",
  "author": "Pixel Dynasty",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "se.pixeldynasty.game",
    "productName": "Pixel Dynasty",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "feedback-url.txt",
      {
        "from": "../dist",
        "to": "game",
        "filter": [
          "index.html"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Pixel-Dynasty-Windows.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "Pixel-Dynasty-Mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "Pixel-Dynasty-Linux.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
